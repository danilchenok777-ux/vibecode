GODHEAD_ENV=development
GODHEAD_DATABASE_URL=sqlite:///./godhead.db
GODHEAD_JWT_SECRET=replace-with-a-long-random-secret-before-deploy
GODHEAD_ACCESS_TOKEN_MINUTES=20
GODHEAD_CORS_ORIGINS=http://localhost:3000
GODHEAD_ATTACHMENT_STORAGE_BACKEND=s3

# Docker Compose PostgreSQL values. Use a URL-safe generated password.
POSTGRES_DB=godhead
POSTGRES_USER=godhead
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password

# Private S3-compatible media storage (Docker Compose starts MinIO locally).
GODHEAD_S3_ENDPOINT_URL=http://127.0.0.1:9000
# For Android emulator access, replace localhost with http://10.0.2.2:9000.
GODHEAD_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
GODHEAD_S3_REGION=us-east-1
GODHEAD_S3_BUCKET=godhead-media
GODHEAD_S3_ACCESS_KEY=godhead-dev-access
GODHEAD_S3_SECRET_KEY=development-only-minio-secret
GODHEAD_S3_PRESIGN_TTL_SECONDS=300

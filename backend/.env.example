GODHEAD_ENV=development
GODHEAD_DATABASE_URL=sqlite:///./godhead.db
GODHEAD_JWT_SECRET=replace-with-a-long-random-secret-before-deploy
GODHEAD_ACCESS_TOKEN_MINUTES=20
GODHEAD_CORS_ORIGINS=http://localhost:3000

# Docker Compose PostgreSQL values. Use a URL-safe generated password.
POSTGRES_DB=godhead
POSTGRES_USER=godhead
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password
